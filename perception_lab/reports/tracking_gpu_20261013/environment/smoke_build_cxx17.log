extern "C" __global__ void __launch_bounds__(128, 1) add_kernel(const float* __restrict__ A, const float* __restrict__ B, float* __restrict__ C) {
  float2 __1;
    float2 v_ = *(float2*)(A + (((int)threadIdx.x) * 2));
    float2 v__1 = *(float2*)(B + (((int)threadIdx.x) * 2));
    __1.x = (v_.x+v__1.x);
    __1.y = (v_.y+v__1.y);
  *(float2*)(C + (((int)threadIdx.x) * 2)) = __1;
}

