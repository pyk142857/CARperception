#else
#define TL_EXPORT
#endif

#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];

extern "C" TL_EXPORT const char* get_last_error() {
    return error_buf;
}

extern "C" TL_EXPORT int init() {
    error_buf[0] = '\0';
    
    return 0;
}

extern "C" TL_EXPORT int call(float* __restrict__ A, float* __restrict__ B, float* __restrict__ C, cudaStream_t stream=cudaStreamDefault) {

	{
		cudaLaunchConfig_t config;
		cudaLaunchAttribute attribute[1];
		attribute[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
		attribute[0].val.programmaticStreamSerializationAllowed = 1;
		config.attrs = attribute;
		config.numAttrs = 1;
		config.stream = stream;
		config.gridDim = dim3(1, 1, 1);
		config.blockDim = dim3(128, 1, 1);
		config.dynamicSmemBytes = 0;
		cudaLaunchKernelEx(&config, add_kernel, A, B, C);
	}
	TILELANG_CHECK_LAST_ERROR("add_kernel");

	return 0;
}

